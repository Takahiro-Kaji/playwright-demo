# After AWS provisioning, run scripts/configure-test-env.sh instead.
# These are LOCAL port-forward endpoints, not public AWS endpoints.
TEST_ENV=staging
BASE_URL=http://127.0.0.1:18080
KUBE_CONTEXT=play-right-demo-eks
KUBE_NAMESPACE=integration-demo
KUBE_DEPLOYMENT=demo-app
MOCK_DEPLOYMENT=status-mock
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=integration_demo
MYSQL_USER=integration_ro
# This file is OUTSIDE the repository and chmod 600.
MYSQL_OPTIONS_FILE=/absolute/path/to/mysql-readonly.cnf
