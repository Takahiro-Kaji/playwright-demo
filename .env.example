# Non-production endpoints only. Never commit your real .env.
TEST_ENV=staging
BASE_URL=https://staging.example.com

# kubectl access (read-only RBAC is sufficient)
KUBE_CONTEXT=example-staging
KUBE_NAMESPACE=example-app
KUBE_DEPLOYMENT=example-web

# External MySQL (network access / VPN / allowlist configured separately)
MYSQL_HOST=staging-db.example.com
MYSQL_PORT=3306
MYSQL_DATABASE=example_app
MYSQL_USER=integration_readonly
# File is OUTSIDE this repository and chmod 600. See README.
MYSQL_OPTIONS_FILE=/absolute/path/to/private/mysql-test.cnf
