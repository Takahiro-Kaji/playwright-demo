{
  "name": "sales-integration-learning",
  "version": "1.0.0",
  "private": true,
  "description": "Local sales management integration test learning with Playwright",
  "scripts": {
    "test:unit": "npm run sales:test:unit && npm run sales:test:verification",
    "test:integration": "playwright test -c sales.config.ts",
    "test:integration:headed": "playwright test -c sales.config.ts --headed",
    "test:list": "playwright test -c sales.config.ts --list --reporter=list",
    "test:syntax": "npm run sales:check",
    "sales:check": "tsc --noEmit --module esnext --moduleResolution bundler --target es2022 --types node --allowImportingTsExtensions --skipLibCheck demo/sales/*.ts test-support/*.ts test-support/auth/*.ts tests/targets/sales/*.ts tests/scenarios/*/*.ts tests/verification/*/*.ts tests/real-app/*.ts aws/sales/*.ts tests/aws-sales/*.ts tests/verification/aws-sales/*.ts aws/tests/mysql*.test.ts aws/tests/local*.ts",
    "sales:test:unit": "node --test tests/verification/sales-demo/*.test.ts tests/verification/support/*.test.ts tests/verification/auth/*.test.ts",
    "sales:test:verification": "node --test tests/verification/sales-comparison/*.test.ts",
    "sales:test:ui": "playwright test -c sales.config.ts tests/scenarios/ui",
    "sales:test:batch": "playwright test -c sales.config.ts tests/scenarios/batch",
    "sales:test:cross": "playwright test -c sales.config.ts tests/scenarios/cross-feature",
    "sales:test": "npm run sales:check && npm run sales:test:unit && npm run sales:test:verification && playwright test -c sales.config.ts",
    "sales:auth:setup": "node test-support/auth/setup.ts",
    "real-app:test": "playwright test -c tests/real-app/real-app.config.ts",
    "test": "npm run sales:test",
    "aws-sales:test": "playwright test -c tests/aws-sales/aws-sales.config.ts",
    "aws-sales:manage": "node tests/aws-sales/manage.ts",
    "aws-sales:list": "playwright test -c tests/aws-sales/aws-sales.config.ts --list",
    "aws-sales:sso": "playwright test -c aws/tests/sso.config.ts",
    "aws-sales:verify": "node --test tests/verification/aws-sales/*.test.ts",
    "aws-sales:local": "playwright test -c tests/aws-sales/local.config.ts",
    "aws-sales:run": "node tests/aws-sales/run.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.6",
    "dotenv": "^16.6.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "mysql2": "^3.24.6"
  }
}
