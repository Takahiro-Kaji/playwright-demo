{
  "name": "playwright-kubectl-mysql-integration-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Two-region EKS, shared RDS MySQL, random request routing, curl-controlled status mocks and Chrome integration tests",
  "scripts": {
    "test:unit": "node --test tests/*.unit.test.cjs",
    "test:integration": "playwright test",
    "test:integration:headed": "playwright test --headed",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "test:syntax": "node scripts/check-syntax.cjs",
    "test:local": "node scripts/local-e2e.cjs",
    "test:verification": "node scripts/verify-runner.cjs",
    "test:batch:local": "node scripts/local-batch.cjs",
    "test:batch:verification": "node scripts/verify-batch-failure.cjs",
    "test:cross:local": "node scripts/local-cross.cjs",
    "test:cross:verification": "node scripts/verify-cross-no-overlap.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "dotenv": "^16.6.1"
  },
  "engines": {
    "node": ">=22"
  }
}
