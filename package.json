{
  "name": "playwright-kubectl-mysql-integration-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Google Chrome + Kubernetes + external MySQL integration test starter",
  "scripts": {
    "test:unit": "node --test tests/*.unit.test.cjs",
    "test:integration": "playwright test tests/create-item.integration.spec.cjs",
    "test:integration:headed": "playwright test tests/create-item.integration.spec.cjs --headed",
    "test:list": "playwright test --list",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "dotenv": "^16.6.1"
  },
  "engines": {
    "node": ">=22"
  }
}
